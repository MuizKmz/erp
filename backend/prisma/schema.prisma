// Zora Pro ERP — one schema for every module.
// Table prefixes (via @@map): sys_ platform · mdm_ master data (seed only, read through MasterDataPort)
// inv_ / sal_ stubs · pur_ purchase.
// Conventions: uuid CHAR(36) ids, tenantId on every table with an index starting with it,
// money Decimal(18,2), unit price / qty Decimal(18,4), rates Decimal(7,4), timestamps DATETIME(3) in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// sys_ · platform
// ─────────────────────────────────────────────────────────────────────────────

model SysTenant {
  id           String   @id @default(uuid()) @db.Char(36)
  code         String   @unique @db.VarChar(20)
  name         String   @db.VarChar(150)
  baseCurrency String   @default("MYR") @db.Char(3)
  timezone     String   @default("Asia/Kuala_Lumpur") @db.VarChar(50)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  @@map("sys_tenant")
}

/// One running number per document type. NumberingService locks the row (SELECT … FOR UPDATE)
/// inside the caller's transaction, so numbers are never handed out twice.
model SysNumberSequence {
  id            String   @id @default(uuid()) @db.Char(36)
  tenantId      String   @db.Char(36)
  module        String   @default("purchase") @db.VarChar(20)
  docType       String   @db.VarChar(20) // PO, PRQ, GRN …
  name          String   @default("") @db.VarChar(60) // "Purchase order", shown on Document types
  prefix        String   @db.VarChar(20) // "PO-"
  digits        Int      @default(4)
  nextValue     Int      @default(1)
  /// Optional pattern with {YYMM} {YYYY} {BR} {####}, e.g. "EQ-{YYMM}-{####}". Null = prefix + running number.
  format        String?  @db.VarChar(40)
  /// NEVER or MONTH. MONTH starts again at 1 when the month (periodKey) changes.
  resetEvery    String   @default("NEVER") @db.VarChar(10)
  periodKey     String?  @db.VarChar(10) // "2609" for the month nextValue belongs to
  perBranch     Boolean  @default(false) // shown on Document types; one sequence per type in this phase
  printTemplate String?  @db.VarChar(40)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  @@unique([tenantId, docType])
  @@map("sys_number_sequence")
}

/// Who did what to which document. Shown in the Activity panel of every document.
model SysActivity {
  id         String   @id @default(uuid()) @db.Char(36)
  tenantId   String   @db.Char(36)
  entityType String   @db.VarChar(40) // e.g. PUR_ORDER
  entityId   String   @db.Char(36)
  docNo      String?  @db.VarChar(30)
  action     String   @db.VarChar(40) // created, submitted, approved, released …
  message    String   @db.VarChar(500)
  comment    String?  @db.Text
  data       Json?
  userCode   String   @db.VarChar(20)
  userName   String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([tenantId, entityType, entityId, createdAt])
  @@map("sys_activity")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  QUEUED // a later step, not active yet
  WAITING // the active step, sits in the approver's inbox
  APPROVED
  REJECTED
  SKIPPED // never reached because the request was rejected or cancelled
}

/// A generic approval request for any document. The owning module decides the steps
/// (e.g. Purchasing Manager, then Finance Director) and reacts to the outcome.
model SysApprovalRequest {
  id              String            @id @default(uuid()) @db.Char(36)
  tenantId        String            @db.Char(36)
  entityType      String            @db.VarChar(40)
  entityId        String            @db.Char(36)
  docNo           String            @db.VarChar(30)
  branchCode      String            @db.VarChar(10)
  amount          Decimal?          @db.Decimal(18, 2)
  title           String            @db.VarChar(200) // what is being approved, for the inbox
  reason          String            @db.VarChar(500) // why approval is needed, e.g. "Over the HQ limit of RM 10,000.00"
  requesterNote   String?           @db.Text
  requestedByCode String            @db.VarChar(20)
  requestedByName String            @db.VarChar(100)
  status          ApprovalStatus    @default(PENDING)
  currentStep     Int               @default(1)
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  decidedAt       DateTime?         @db.DateTime(3)
  steps           SysApprovalStep[]

  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
  @@map("sys_approval_request")
}

model SysApprovalStep {
  id            String             @id @default(uuid()) @db.Char(36)
  tenantId      String             @db.Char(36)
  requestId     String             @db.Char(36)
  stepNo        Int
  approverRole  String             @db.VarChar(40) // PURCHASE_MANAGER …
  approverCode  String?            @db.VarChar(20) // a named approver, when the rule names one
  approverName  String?            @db.VarChar(100)
  status        ApprovalStepStatus @default(QUEUED)
  decidedByCode String?            @db.VarChar(20)
  decidedByName String?            @db.VarChar(100)
  comment       String?            @db.Text
  decidedAt     DateTime?          @db.DateTime(3)
  request       SysApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepNo])
  @@index([tenantId, status, approverRole])
  @@map("sys_approval_step")
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

/// Events for other modules, written in the same transaction as the change (see docs/integration/EVENTS.md).
/// Events that no module listens to yet simply stay PENDING until one is connected.
model SysOutbox {
  id            String       @id @default(uuid()) @db.Char(36)
  seq           Int          @unique @default(autoincrement()) // delivery order
  tenantId      String       @db.Char(36)
  name          String       @db.VarChar(100) // purchase.order.released
  version       Int          @default(1)
  aggregateType String       @db.VarChar(40)
  aggregateId   String       @db.Char(36)
  payload       Json
  actorCode     String       @db.VarChar(20)
  correlationId String       @db.Char(36)
  occurredAt    DateTime     @default(now()) @db.DateTime(3)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.DateTime(3)
  lastError     String?      @db.Text
  dispatchedAt  DateTime?    @db.DateTime(3)

  @@index([tenantId, status, name])
  @@index([status, nextAttemptAt])
  @@index([name, seq]) // module listeners look for the oldest event of a name they have not handled
  @@map("sys_outbox")
}

/// Idempotency for event consumers: one row per (event, handler) that has processed it.
model SysEventHandled {
  eventId   String   @db.Char(36)
  handler   String   @db.VarChar(100)
  tenantId  String   @db.Char(36)
  handledAt DateTime @default(now()) @db.DateTime(3)

  @@id([eventId, handler])
  @@index([tenantId, handledAt])
  @@map("sys_event_handled")
}

/// Files stored on local disk under backend/uploads. Uploaded first, then attached to a document.
model SysAttachment {
  id             String   @id @default(uuid()) @db.Char(36)
  tenantId       String   @db.Char(36)
  entityType     String?  @db.VarChar(40)
  entityId       String?  @db.Char(36)
  kind           String?  @db.VarChar(40) // RECEIPT_PHOTO, SUPPLIER_LETTER, DO_PHOTO …
  fileName       String   @db.VarChar(255)
  mimeType       String   @db.VarChar(100)
  sizeBytes      Int
  storageKey     String   @db.VarChar(500) // path relative to UPLOAD_DIR
  uploadedByCode String   @db.VarChar(20)
  createdAt      DateTime @default(now()) @db.DateTime(3)

  @@index([tenantId, entityType, entityId])
  @@map("sys_attachment")
}

/// One edge in a document chain, always from the earlier document to the later one:
/// PRQ-0001 → RFQ-0001 → PO-0001 → GRN-0001 → PI-0001. Powers Document flow and Linked documents.
/// Ids are null for documents outside this system (e.g. a sales order before Sales exists).
model SysDocLink {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  fromType  String   @db.VarChar(40)
  fromId    String?  @db.Char(36)
  fromNo    String   @db.VarChar(30)
  toType    String   @db.VarChar(40)
  toId      String?  @db.Char(36)
  toNo      String   @db.VarChar(30)
  linkType  String   @db.VarChar(30) // CONVERTED, AWARDED, RECEIVED, BILLED, RETURNED, CANCELLED, DEBITED, DRAFTED_FROM
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([tenantId, fromType, fromId])
  @@index([tenantId, toType, toId])
  @@map("sys_doc_link")
}

/// Emails are not sent in phase 1: they are written here and the UI shows "Sent".
model SysEmailLog {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  entityType  String?  @db.VarChar(40)
  entityId    String?  @db.Char(36)
  docNo       String?  @db.VarChar(30)
  templateKey String?  @db.VarChar(50)
  toAddress   String   @db.VarChar(500)
  ccAddress   String?  @db.VarChar(500)
  subject     String   @db.VarChar(300)
  body        String   @db.Text
  sentByCode  String   @db.VarChar(20)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, templateKey, createdAt])
  @@map("sys_email_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// mdm_ · master data (local seed tables, phase 1). Only MasterDataPort reads these.
// ─────────────────────────────────────────────────────────────────────────────

model MdmBranch {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  code      String   @db.VarChar(10) // HQ, PNG
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@unique([tenantId, code])
  @@map("mdm_branch")
}

model MdmUser {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  code        String   @db.VarChar(20) // LMY
  name        String   @db.VarChar(100)
  email       String   @db.VarChar(150)
  roles       Json // string[]: PURCHASE_BUYER, PURCHASE_MANAGER …
  branchCodes Json // string[]: HQ, PNG
  department  String?  @db.VarChar(50) // Production, Office …
  jobTitle    String?  @db.VarChar(50) // "Store", "Admin": shown as "Rahim · Store"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@unique([tenantId, code])
  @@map("mdm_user")
}

enum MdmRecordStatus {
  ACTIVE
  BLOCKED
}

enum MdmItemStatus {
  ACTIVE
  BLOCKED
  DISCONTINUED
}

enum MdmItemType {
  STOCK
  NON_STOCK
  SERVICE
  ASSET
}

model MdmWarehouse {
  id         String   @id @default(uuid()) @db.Char(36)
  tenantId   String   @db.Char(36)
  code       String   @db.VarChar(20) // HQ-MAIN
  name       String   @db.VarChar(100)
  branchCode String   @db.VarChar(10)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@unique([tenantId, code])
  @@map("mdm_warehouse")
}

/// Rack / bin. Codes must match WMS location codes (HQ-MAIN/B-03).
model MdmLocation {
  id            String   @id @default(uuid()) @db.Char(36)
  tenantId      String   @db.Char(36)
  warehouseCode String   @db.VarChar(20)
  code          String   @db.VarChar(30)
  name          String   @db.VarChar(100)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  @@unique([tenantId, code])
  @@index([tenantId, warehouseCode])
  @@map("mdm_location")
}

model MdmUom {
  id       String  @id @default(uuid()) @db.Char(36)
  tenantId String  @db.Char(36)
  code     String  @db.VarChar(10)
  name     String  @db.VarChar(50)
  decimals Int     @default(0)
  isActive Boolean @default(true)

  @@unique([tenantId, code])
  @@map("mdm_uom")
}

model MdmUomConversion {
  id       String  @id @default(uuid()) @db.Char(36)
  tenantId String  @db.Char(36)
  itemCode String  @db.VarChar(30)
  fromUom  String  @db.VarChar(10)
  toUom    String  @db.VarChar(10)
  factor   Decimal @db.Decimal(18, 6)

  @@unique([tenantId, itemCode, fromUom, toUom])
  @@map("mdm_uom_conversion")
}

model MdmTaxCode {
  id        String    @id @default(uuid()) @db.Char(36)
  tenantId  String    @db.Char(36)
  code      String    @db.VarChar(20) // SST10, SVC8, EXEMPT
  name      String    @db.VarChar(60) // "SST 10%", the label screens show
  rate      Decimal   @db.Decimal(7, 4) // fraction: 0.1000 = 10%
  country   String    @default("MY") @db.Char(2)
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  isActive  Boolean   @default(true)

  @@unique([tenantId, code])
  @@map("mdm_tax_code")
}

model MdmSupplier {
  id              String          @id @default(uuid()) @db.Char(36)
  tenantId        String          @db.Char(36)
  code            String          @db.VarChar(20) // S-0021
  name            String          @db.VarChar(150)
  shortName       String?         @db.VarChar(60) // "Kilang Kain Jaya" in compact lists
  category        String?         @db.VarChar(100) // what they supply
  regNo           String?         @db.VarChar(30)
  tin             String?         @db.VarChar(30)
  sstNo           String?         @db.VarChar(30) // null = not SST registered
  paymentTermDays Int             @default(30)
  currency        String          @default("MYR") @db.Char(3)
  contactName     String?         @db.VarChar(100)
  email           String?         @db.VarChar(150)
  phone           String?         @db.VarChar(30)
  address         String?         @db.VarChar(300)
  isWalkIn        Boolean         @default(false) // shops used for cash purchases
  status          MdmRecordStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @db.DateTime(3)

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("mdm_supplier")
}

model MdmItem {
  id                    String        @id @default(uuid()) @db.Char(36)
  tenantId              String        @db.Char(36)
  code                  String        @db.VarChar(30) // FB-OAK-01
  name                  String        @db.VarChar(150)
  itemGroup             String        @db.VarChar(50)
  type                  MdmItemType
  baseUom               String        @db.VarChar(10)
  purchaseUom           String?       @db.VarChar(10)
  salesUom              String?       @db.VarChar(10)
  isPurchasable         Boolean       @default(true)
  isSellable            Boolean       @default(false)
  isBuyToOrder          Boolean       @default(false) // bought only against a sales order
  purchaseTaxCode       String        @db.VarChar(20)
  salesTaxCode          String?       @db.VarChar(20)
  preferredSupplierCode String?       @db.VarChar(20)
  reorderLevel          Decimal?      @db.Decimal(18, 4)
  packSize              Decimal       @default(1) @db.Decimal(18, 4)
  barcode               String?       @db.VarChar(30)
  standardCost          Decimal?      @db.Decimal(18, 4) // for the estimated margin on sales documents
  status                MdmItemStatus @default(ACTIVE)
  createdAt             DateTime      @default(now()) @db.DateTime(3)
  updatedAt             DateTime      @updatedAt @db.DateTime(3)

  @@unique([tenantId, code])
  @@index([tenantId, isPurchasable, status])
  @@map("mdm_item")
}

/// A price agreed with a supplier for a period. Items with a contract price skip the RFQ (rule 4).
model MdmContractPrice {
  id           String    @id @default(uuid()) @db.Char(36)
  tenantId     String    @db.Char(36)
  itemCode     String    @db.VarChar(30)
  supplierCode String    @db.VarChar(20)
  unitPrice    Decimal   @db.Decimal(18, 4)
  validFrom    DateTime  @db.Date
  validTo      DateTime? @db.Date

  @@index([tenantId, itemCode])
  @@map("mdm_contract_price")
}

// ─────────────────────────────────────────────────────────────────────────────
// inv_ / sal_ · read-only stubs until Inventory and Sales are connected
// ─────────────────────────────────────────────────────────────────────────────

model InvStockSnapshot {
  id             String   @id @default(uuid()) @db.Char(36)
  tenantId       String   @db.Char(36)
  warehouseCode  String   @db.VarChar(20)
  itemCode       String   @db.VarChar(30)
  onHand         Decimal  @db.Decimal(18, 4)
  usedLast30Days Decimal  @default(0) @db.Decimal(18, 4)
  asOf           DateTime @db.DateTime(3)

  @@unique([tenantId, warehouseCode, itemCode])
  @@map("inv_stock_snapshot")
}

enum SalDemandKind {
  DIRECT // the sales line sells this item: counts in the demand list
  COMPONENT // the item is used to make what is sold: shown for information only
}

/// Open sales-order needs from before the Sales module existed. Unused since Purchase keeps its own copy from Sales
/// events (PurSalesDemand); kept, empty, until dropping it is agreed.
model SalDemandStub {
  id           String        @id @default(uuid()) @db.Char(36)
  tenantId     String        @db.Char(36)
  branchCode   String        @db.VarChar(10)
  soNo         String        @db.VarChar(30)
  soDate       DateTime      @db.Date
  customerName String        @db.VarChar(150)
  soTotal      Decimal       @db.Decimal(18, 2)
  itemCode     String        @db.VarChar(30)
  qty          Decimal       @db.Decimal(18, 4)
  kind         SalDemandKind @default(DIRECT)
  isBuyToOrder Boolean       @default(false)
  neededBy     DateTime?     @db.Date

  @@index([tenantId, itemCode])
  @@index([tenantId, soNo])
  @@map("sal_demand_stub")
}

// ─────────────────────────────────────────────────────────────────────────────
// pur_ · purchase
// Every document: docNo (unique per tenant), docDate, status, branchCode, remarks, version, created/updated
// at+by, isMigrated. Lines keep the item reference AND a snapshot (code, name, uom, tax, price).
// ─────────────────────────────────────────────────────────────────────────────

enum PurRequestStatus {
  DRAFT
  SUBMITTED
  CONVERTED
  REJECTED
}

enum PurRequestPriority {
  NORMAL
  URGENT
}

enum PurRequestSource {
  DEMAND
  STAFF
  SALES_ORDER
}

model PurRequest {
  id              String             @id @default(uuid()) @db.Char(36)
  tenantId        String             @db.Char(36)
  docNo           String             @db.VarChar(30)
  docDate         DateTime           @db.Date
  status          PurRequestStatus   @default(DRAFT)
  branchCode      String             @db.VarChar(10)
  requestedByCode String             @db.VarChar(20)
  requestedByName String             @db.VarChar(100)
  department      String?            @db.VarChar(50)
  requesterTitle  String?            @db.VarChar(50) // snapshot of the requester's job title
  neededBy        DateTime?          @db.Date
  priority        PurRequestPriority @default(NORMAL)
  source          PurRequestSource   @default(STAFF)
  reason          String?            @db.Text
  summary         String?            @db.VarChar(200) // "Wood screws ×20, lacquer ×8" for the list
  estValue        Decimal            @default(0) @db.Decimal(18, 2)
  rejectReason    String?            @db.VarChar(500)
  submittedAt     DateTime?          @db.DateTime(3)
  decidedAt       DateTime?          @db.DateTime(3) // converted or rejected
  decidedByCode   String?            @db.VarChar(20)
  remarks         String?            @db.Text
  version         Int                @default(1)
  isMigrated      Boolean            @default(false)
  createdAt       DateTime           @default(now()) @db.DateTime(3)
  createdBy       String             @db.VarChar(20)
  updatedAt       DateTime           @updatedAt @db.DateTime(3)
  updatedBy       String             @db.VarChar(20)
  lines           PurRequestLine[]
  rfqs            PurRfq[]
  orders          PurPurchaseOrder[]

  @@unique([tenantId, docNo])
  @@index([tenantId, status, docDate])
  @@map("pur_request")
}

model PurRequestLine {
  id                    String     @id @default(uuid()) @db.Char(36)
  tenantId              String     @db.Char(36)
  requestId             String     @db.Char(36)
  lineNo                Int
  itemId                String     @db.Char(36)
  itemCode              String     @db.VarChar(30)
  itemName              String     @db.VarChar(150)
  uomCode               String     @db.VarChar(10)
  taxCode               String     @db.VarChar(20)
  taxRate               Decimal    @db.Decimal(7, 4)
  unitPrice             Decimal    @db.Decimal(18, 4) // last price at the time of the request
  qty                   Decimal    @db.Decimal(18, 4)
  estAmount             Decimal    @db.Decimal(18, 2)
  preferredSupplierCode String?    @db.VarChar(20)
  preferredSupplierName String?    @db.VarChar(150)
  request               PurRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, lineNo])
  @@index([tenantId, itemCode])
  @@map("pur_request_line")
}

enum PurRfqStatus {
  DRAFT
  WAITING
  READY
  AWARDED
  CLOSED
}

enum PurRfqSupplierStatus {
  ASKED
  REPLIED
  DECLINED
}

model PurRfq {
  id                  String             @id @default(uuid()) @db.Char(36)
  tenantId            String             @db.Char(36)
  docNo               String             @db.VarChar(30)
  docDate             DateTime           @db.Date
  status              PurRfqStatus       @default(DRAFT)
  branchCode          String             @db.VarChar(10)
  buyerCode           String             @db.VarChar(20)
  buyerName           String             @db.VarChar(100)
  requestId           String?            @db.Char(36)
  sourceNo            String?            @db.VarChar(30) // PRQ-0003, SO-0008; null = raised by the buyer
  summary             String?            @db.VarChar(200)
  neededBy            DateTime?          @db.Date
  replyBy             DateTime?          @db.Date
  sentAt              DateTime?          @db.DateTime(3)
  awardedSupplierCode String?            @db.VarChar(20)
  awardedSupplierName String?            @db.VarChar(150)
  awardReason         String?            @db.Text // required when the winner is not the cheapest
  awardedAt           DateTime?          @db.DateTime(3)
  awardedByCode       String?            @db.VarChar(20)
  closeReason         String?            @db.VarChar(300)
  remarks             String?            @db.Text
  version             Int                @default(1)
  isMigrated          Boolean            @default(false)
  createdAt           DateTime           @default(now()) @db.DateTime(3)
  createdBy           String             @db.VarChar(20)
  updatedAt           DateTime           @updatedAt @db.DateTime(3)
  updatedBy           String             @db.VarChar(20)
  request             PurRequest?        @relation(fields: [requestId], references: [id])
  lines               PurRfqLine[]
  suppliers           PurRfqSupplier[]
  orders              PurPurchaseOrder[]

  @@unique([tenantId, docNo])
  @@index([tenantId, status, docDate])
  @@map("pur_rfq")
}

model PurRfqLine {
  id         String            @id @default(uuid()) @db.Char(36)
  tenantId   String            @db.Char(36)
  rfqId      String            @db.Char(36)
  lineNo     Int
  itemId     String            @db.Char(36)
  itemCode   String            @db.VarChar(30)
  itemName   String            @db.VarChar(150)
  uomCode    String            @db.VarChar(10)
  taxCode    String            @db.VarChar(20)
  taxRate    Decimal           @db.Decimal(7, 4)
  qty        Decimal           @db.Decimal(18, 4)
  rfq        PurRfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  replyLines PurRfqReplyLine[]

  @@unique([rfqId, lineNo])
  @@index([tenantId])
