/// What happens on a credit breach, per document (S29 table).
model SalCreditRule {
  id                String   @id @default(uuid()) @db.Char(36)
  tenantId          String   @db.Char(36)
  docType           String   @db.VarChar(20) // QUOTATION, SALES_ORDER, DELIVERY, INVOICE, CASH_SALE
  overCreditAction  String   @db.VarChar(20) // ALLOW, WARN, APPROVAL, BLOCK
  overOverdueAction String   @db.VarChar(20)
  approverRole      String?  @db.VarChar(40) // SALES_MANAGER, FINANCE_MANAGER
  sortOrder         Int      @default(0)
  updatedAt         DateTime @updatedAt @db.DateTime(3)
  updatedBy         String   @db.VarChar(20)

  @@unique([tenantId, docType])
  @@map("sal_credit_rule")
}

model SalSettingChange {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  area      String   @db.VarChar(30) // CREDIT_CONTROL, DOCUMENT_TYPES, ENQUIRY_TYPES, EXCLUDED_ITEMS, EMAIL_TEMPLATES
  message   String   @db.VarChar(300)
  userCode  String   @db.VarChar(20)
  userName  String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([tenantId, area, createdAt])
  @@map("sal_setting_change")
}

model SalOrderType {
  id        String  @id @default(uuid()) @db.Char(36)
  tenantId  String  @db.Char(36)
  code      String  @db.VarChar(10) // STD, BTO, PRJ
  name      String  @db.VarChar(60)
  meaning   String  @db.VarChar(200)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([tenantId, code])
  @@map("sal_order_type")
}

model SalEnquiryType {
  id               String  @id @default(uuid()) @db.Char(36)
  tenantId         String  @db.Char(36)
  code             String  @db.VarChar(20)
  name             String  @db.VarChar(60)
  details          Json // [{ label, kind: TEXT|CHOICE|FILE|NUMBER|DATE, required, choices? }]
  defaultAgentRule String  @default("CUSTOMER") @db.VarChar(20) // CUSTOMER (the customer's agent), ROUND_ROBIN
  isActive         Boolean @default(true)
  sortOrder        Int     @default(0)

  @@unique([tenantId, code])
  @@map("sal_enquiry_type")
}

model SalEnquirySource {
  id        String  @id @default(uuid()) @db.Char(36)
  tenantId  String  @db.Char(36)
  code      String  @db.VarChar(20)
  name      String  @db.VarChar(60)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([tenantId, code])
  @@map("sal_enquiry_source")
}

/// Items that cannot be sold in a branch (S32), without changing the item in Master Data.
model SalExcludedItem {
  id          String    @id @default(uuid()) @db.Char(36)
  tenantId    String    @db.Char(36)
  itemCode    String    @db.VarChar(30)
  itemName    String    @db.VarChar(150)
  branchCode  String    @db.VarChar(10)
  reason      String    @db.VarChar(100)
  fromDate    DateTime  @db.Date
  untilDate   DateTime? @db.Date
  addedByCode String    @db.VarChar(20)
  addedByName String    @db.VarChar(100)
  removedAt   DateTime? @db.DateTime(3)
  removedBy   String?   @db.VarChar(20)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  @@index([tenantId, branchCode, itemCode])
  @@map("sal_excluded_item")
}

/// Email templates (S33). Variables use single braces: {document.number}.
model SalEmailTemplate {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  key         String   @db.VarChar(50) // QUOTATION, ORDER_CONFIRMATION, INVOICE …
  name        String   @db.VarChar(100)
  description String   @db.VarChar(200)
  subject     String   @db.VarChar(300)
  body        String   @db.Text
  attachPdf   Boolean  @default(true)
  copyAgent   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedBy   String   @db.VarChar(20)

  @@unique([tenantId, key])
  @@map("sal_email_template")
}
