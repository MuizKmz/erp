  branchCode       String             @db.VarChar(10)
  customerId       String             @db.Char(36)
  customerCode     String             @db.VarChar(20)
  customerName     String             @db.VarChar(150)
  contactName      String?            @db.VarChar(100)
  agentCode        String             @db.VarChar(20)
  agentName        String             @db.VarChar(100)
  currency         String             @default("MYR") @db.Char(3)
  taxMode          String             @default("EXCLUSIVE") @db.VarChar(10)
  creditTermDays   Int                @default(30)
  priceListCode    String             @db.VarChar(20)
  enquiryId        String?            @db.Char(36)
  enquiryNo        String?            @db.VarChar(30)
  customerNote     String?            @db.Text // printed
  internalNote     String?            @db.Text
  subtotal         Decimal            @default(0) @db.Decimal(18, 2) // sum of gross
  discountTotal    Decimal            @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal            @default(0) @db.Decimal(18, 2)
  rounding         Decimal            @default(0) @db.Decimal(18, 2)
  total            Decimal            @default(0) @db.Decimal(18, 2)
  costTotal        Decimal?           @db.Decimal(18, 2) // for the estimated margin
