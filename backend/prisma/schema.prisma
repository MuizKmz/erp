  RECORD_RECEIVED
  HOLD
  ACCEPT_AS_BILLED
}

enum PurMatchResult {
  NOT_MATCHED
  MATCHED
  DIFFERENCE
}

/// A supplier invoice. "billed*" is what the supplier asks for; subtotal/taxTotal/total is what we record.
model PurInvoice {
  id                String              @id @default(uuid()) @db.Char(36)
  tenantId          String              @db.Char(36)
  docNo             String              @db.VarChar(30)
  docDate           DateTime            @db.Date
  status            PurInvoiceStatus    @default(DRAFT)
  branchCode        String              @db.VarChar(10)
  supplierId        String              @db.Char(36)
  supplierCode      String              @db.VarChar(20)
  supplierName      String              @db.VarChar(150)
  supplierInvoiceNo String              @db.VarChar(50)
  invoiceDate       DateTime            @db.Date
  dueDate           DateTime?           @db.Date
  poId              String              @db.Char(36)
  poNo              String              @db.VarChar(30)
  currency          String              @default("MYR") @db.Char(3)
  billedSubtotal    Decimal             @default(0) @db.Decimal(18, 2)
  billedTax         Decimal             @default(0) @db.Decimal(18, 2)
  billedTotal       Decimal             @default(0) @db.Decimal(18, 2)
  subtotal          Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal          Decimal             @default(0) @db.Decimal(18, 2)
  total             Decimal             @default(0) @db.Decimal(18, 2)
  matchResult       PurMatchResult      @default(NOT_MATCHED)
  matchSummary      String?             @db.VarChar(200) // "Qty fixed 100 → 95", "Price +3.2% · freight"
  decision          PurInvoiceDecision?
  supplierNote      String?             @db.VarChar(500)
  decisionNote      String?             @db.Text // buyer's note to the approver
  messageToSupplier String?             @db.Text
  eInvoiceStatus    String?             @db.VarChar(20) // VALIDATED once LHDN e-Invoice checks pass
  approvedAt        DateTime?           @db.DateTime(3)
  approvedByCode    String?             @db.VarChar(20)
  rejectReason      String?             @db.VarChar(500)
  paidAt            DateTime?           @db.DateTime(3)
  remarks           String?             @db.Text
  version           Int                 @default(1)
  isMigrated        Boolean             @default(false)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  createdBy         String              @db.VarChar(20)
  updatedAt         DateTime            @updatedAt @db.DateTime(3)
  updatedBy         String              @db.VarChar(20)
  po                PurPurchaseOrder    @relation(fields: [poId], references: [id])
  lines             PurInvoiceLine[]
  debitNotes        PurDebitNote[]

  @@unique([tenantId, docNo])
  @@unique([tenantId, supplierCode, supplierInvoiceNo]) // the same supplier invoice cannot be recorded twice
  @@index([tenantId, status, docDate])
  @@index([tenantId, poId])
  @@map("pur_invoice")
}

model PurInvoiceLine {
  id              String               @id @default(uuid()) @db.Char(36)
