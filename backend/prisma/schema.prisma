model SalQuotationLine {
  id             String       @id @default(uuid()) @db.Char(36)
  tenantId       String       @db.Char(36)
  quotationId    String       @db.Char(36)
  lineNo         Int
  heading        String?      @db.VarChar(150) // a heading line printed above this line
  itemId         String       @db.Char(36)
  itemCode       String       @db.VarChar(30)
  itemName       String       @db.VarChar(150)
  uomCode        String       @db.VarChar(10)
