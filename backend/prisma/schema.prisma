  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedBy   String   @db.VarChar(20)

  @@unique([tenantId, key])
  @@map("pur_email_template")
}

/// Purchase price history brought over from the old system, plus opening last prices.
/// "Last price" = newest of this table and released PO lines.
model PurPriceHistory {
  id           String   @id @default(uuid()) @db.Char(36)
  tenantId     String   @db.Char(36)
  itemCode     String   @db.VarChar(30)
  supplierCode String?  @db.VarChar(20)
  supplierName String?  @db.VarChar(150)
  docNo        String?  @db.VarChar(30) // null = opening price, not a document
  docDate      DateTime @db.Date
  qty          Decimal? @db.Decimal(18, 4)
  unitPrice    Decimal  @db.Decimal(18, 4)
  note         String?  @db.VarChar(200)

  @@index([tenantId, itemCode, docDate])
  @@map("pur_price_history")
}

/// Supplier delivery record from the old system; new goods receipts add to it.
model PurSupplierStat {
