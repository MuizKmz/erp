  isMigrated       Boolean           @default(false)
  createdAt        DateTime          @default(now()) @db.DateTime(3)
  createdBy        String            @db.VarChar(20)
  updatedAt        DateTime          @updatedAt @db.DateTime(3)
  updatedBy        String            @db.VarChar(20)
  grn              PurGoodsReceipt?  @relation(fields: [grnId], references: [id])
  po               PurPurchaseOrder? @relation(fields: [poId], references: [id])
  lines            PurReturnLine[]

  @@unique([tenantId, docNo])
  @@index([tenantId, status, docDate])
  @@map("pur_return")
}

model PurReturnLine {
  id                String                @id @default(uuid()) @db.Char(36)
  tenantId          String                @db.Char(36)
  returnId          String                @db.Char(36)
  grnLineId         String?               @db.Char(36)
  poLineId          String?               @db.Char(36)
  lineNo            Int
  itemId            String                @db.Char(36)
  itemCode          String                @db.VarChar(30)
  itemName          String                @db.VarChar(150)
  uomCode           String                @db.VarChar(10)
  taxCode           String                @db.VarChar(20)
  taxRate           Decimal               @db.Decimal(7, 4)
  unitPrice         Decimal               @db.Decimal(18, 4)
  receivedQty       Decimal               @db.Decimal(18, 4) // GRN line snapshot
  returnedBeforeQty Decimal               @default(0) @db.Decimal(18, 4)
  qty               Decimal               @db.Decimal(18, 4)
  amount            Decimal               @db.Decimal(18, 2)
  taxAmount         Decimal               @db.Decimal(18, 2)
  purReturn         PurReturn             @relation(fields: [returnId], references: [id], onDelete: Cascade)
  grnLine           PurGoodsReceiptLine?  @relation(fields: [grnLineId], references: [id])
  poLine            PurPurchaseOrderLine? @relation(fields: [poLineId], references: [id])

  @@unique([returnId, lineNo])
  @@index([tenantId, grnLineId])
  @@map("pur_return_line")
}

// ── Purchase settings (Operation Policies) ──────────────────────────────────

/// Approval limits (P24). branchCode null = all branches.
/// condition: OVER_AMOUNT (PO), OUTSIDE_TOLERANCE (PI), CHARGE_NOT_ON_PO (PDN), BLOCKED_OVER_AMOUNT (CP).
model PurApprovalRule {
  id                 String   @id @default(uuid()) @db.Char(36)
  tenantId           String   @db.Char(36)
  docType            String   @db.VarChar(10) // PO, PI, PDN, CP
  branchCode         String?  @db.VarChar(10)
  condition          String   @db.VarChar(30)
  thresholdAmount    Decimal? @db.Decimal(18, 2)
  approverRole       String?  @db.VarChar(40)
  approverCode       String?  @db.VarChar(20)
  secondOverAmount   Decimal? @db.Decimal(18, 2)
  secondApproverRole String?  @db.VarChar(40)
  secondApproverCode String?  @db.VarChar(20)
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  updatedAt          DateTime @updatedAt @db.DateTime(3)
  updatedBy          String   @db.VarChar(20)

  @@index([tenantId, docType])
  @@map("pur_approval_rule")
}

/// One row per tenant: match tolerance and the rule switches (P24), numbering options (P25).
/// Open sales-order needs as Purchase sees them (P04 demand, P06 insights, buy-to-order POs). One row per sales-order
/// line, kept from Sales events: sales.order.released adds the line, sales.shipment.requested and
/// sales.order.balance_cancelled lower what is still open. Purchase-owned: Sales never writes it.
model PurSalesDemand {
  id           String    @id @default(uuid()) @db.Char(36)
  tenantId     String    @db.Char(36)
  salesOrderId String    @db.Char(36) // the event's aggregate id
  soNo         String    @db.VarChar(30)
  soLineNo     Int
  soDate       DateTime  @db.Date
  customerName String    @db.VarChar(150)
  soTotal      Decimal   @db.Decimal(18, 2)
  branchCode   String    @db.VarChar(10)
  itemCode     String    @db.VarChar(30)
  uomCode      String    @db.VarChar(10)
  orderedQty   Decimal   @db.Decimal(18, 4)
  deliveredQty Decimal   @default(0) @db.Decimal(18, 4)
  cancelledQty Decimal   @default(0) @db.Decimal(18, 4)
  isBuyToOrder Boolean   @default(false)
  neededBy     DateTime? @db.Date
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)

  @@unique([tenantId, soNo, soLineNo])
  @@index([tenantId, itemCode])
  @@map("pur_sales_demand")
}

model PurSetting {
  id                      String   @id @default(uuid()) @db.Char(36)
  tenantId                String   @unique @db.Char(36)
  priceTolerancePct       Decimal  @default(2) @db.Decimal(7, 4) // ± % of the PO price
  qtyToleranceOver        Decimal  @default(0) @db.Decimal(18, 4) // units billed over received
  taxToleranceAmount      Decimal  @default(1) @db.Decimal(18, 2) // ± RM
  rfqRequiredOn           Boolean  @default(true)
  rfqRequiredOver         Decimal  @default(50000) @db.Decimal(18, 2)
  rfqMinReplies           Int      @default(2)
  allowOverReceipt        Boolean  @default(false)
  autoDraftBuyToOrder     Boolean  @default(true)
  onlyActiveSuppliers     Boolean  @default(true)
  buyerCannotApproveOwnPo Boolean  @default(true)
  numberWithBranchCode    Boolean  @default(false)
  updatedAt               DateTime @updatedAt @db.DateTime(3)
  updatedBy               String   @db.VarChar(20)

  @@map("pur_setting")
}

/// "Change history" on Approval Rules.
model PurSettingChange {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  area      String   @db.VarChar(30) // APPROVAL_RULES, DOCUMENT_TYPES, EMAIL_TEMPLATES
  message   String   @db.VarChar(300)
  userCode  String   @db.VarChar(20)
  userName  String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([tenantId, area, createdAt])
  @@map("pur_setting_change")
}

/// Email templates (P26). Variables use single braces: {po.number}.
model PurEmailTemplate {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  key         String   @db.VarChar(50) // PO_TO_SUPPLIER …
  name        String   @db.VarChar(100)
  description String   @db.VarChar(200)
