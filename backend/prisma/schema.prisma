  @@index([tenantId, status, docDate])
  @@index([tenantId, supplierCode])
  @@map("pur_purchase_order")
}

/// Running quantities are updated in the same transaction as the document that changes them.
/// Open to receive = orderedQty − receivedQty − cancelledQty.
model PurPurchaseOrderLine {
  id            String                @id @default(uuid()) @db.Char(36)
  tenantId      String                @db.Char(36)
  poId          String                @db.Char(36)
  lineNo        Int
  itemId        String                @db.Char(36)
  itemCode      String                @db.VarChar(30)
  itemName      String                @db.VarChar(150)
  uomCode       String                @db.VarChar(10)
  taxCode       String                @db.VarChar(20)
  taxRate       Decimal               @db.Decimal(7, 4)
  unitPrice     Decimal               @db.Decimal(18, 4)
  orderedQty    Decimal               @db.Decimal(18, 4)
  receivedQty   Decimal               @default(0) @db.Decimal(18, 4)
  billedQty     Decimal               @default(0) @db.Decimal(18, 4)
  returnedQty   Decimal               @default(0) @db.Decimal(18, 4)
  cancelledQty  Decimal               @default(0) @db.Decimal(18, 4)
  amount        Decimal               @db.Decimal(18, 2) // round(orderedQty × unitPrice, 2)
  taxAmount     Decimal               @db.Decimal(18, 2) // round(amount × taxRate, 2)
  requestLineId String?               @db.Char(36)
  salesOrderNo  String?               @db.VarChar(30)
  note          String?               @db.VarChar(300)
  po            PurPurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  receiptLines  PurGoodsReceiptLine[]
  invoiceLines  PurInvoiceLine[]
  cancelLines   PurCancelOrderLine[]
  returnLines   PurReturnLine[]

  @@unique([poId, lineNo])
  @@index([tenantId, itemCode])
  @@map("pur_purchase_order_line")
}

