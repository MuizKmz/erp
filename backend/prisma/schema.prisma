// ─────────────────────────────────────────────────────────────────────────────
// sal_ · Sales
// Lines keep references and snapshots. Money: gross = round(qty × price, 2), discount = round(gross × pct / 100, 2),
// amount = gross − discount, tax = round(amount × rate, 2) (inclusive: round(amount × rate / (1 + rate), 2)).
// ─────────────────────────────────────────────────────────────────────────────

enum SalEnquiryStatus {
  NEW
  FORWARDED
  QUOTED
  LOST
}

model SalEnquiry {
  id              String           @id @default(uuid()) @db.Char(36)
  tenantId        String           @db.Char(36)
  docNo           String           @db.VarChar(30) // EQ-2609-0011
  docDate         DateTime         @db.Date
  status          SalEnquiryStatus @default(NEW)
  branchCode      String           @db.VarChar(10)
  customerId      String?          @db.Char(36)
  customerCode    String?          @db.VarChar(20)
  customerName    String           @db.VarChar(150)
  isProspect      Boolean          @default(false)
  contactName     String?          @db.VarChar(100)
  phone           String?          @db.VarChar(30)
  email           String?          @db.VarChar(150)
  enquiryTypeCode String           @db.VarChar(20)
  sourceCode      String           @db.VarChar(20)
  agentCode       String           @db.VarChar(20)
  agentName       String           @db.VarChar(100)
  budget          Decimal?         @db.Decimal(18, 2)
  neededBy        DateTime?        @db.Date
  customerRef     String?          @db.VarChar(50)
  description     String?          @db.Text
  details         Json? // answers to the enquiry type's extra details
  quotationNo     String?          @db.VarChar(30)
  lostReason      String?          @db.VarChar(200)
  forwardedAt     DateTime?        @db.DateTime(3)
  remarks         String?          @db.Text
  version         Int              @default(1)
  isMigrated      Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  createdBy       String           @db.VarChar(20)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  updatedBy       String           @db.VarChar(20)
  items           SalEnquiryItem[]

  @@unique([tenantId, docNo])
  @@index([tenantId, status, docDate])
  @@map("sal_enquiry")
}

model SalEnquiryItem {
  id        String     @id @default(uuid()) @db.Char(36)
  tenantId  String     @db.Char(36)
  enquiryId String     @db.Char(36)
  lineNo    Int
  itemId    String?    @db.Char(36)
  itemCode  String     @db.VarChar(30)
  itemName  String     @db.VarChar(150)
  uomCode   String     @db.VarChar(10)
  qty       Decimal    @db.Decimal(18, 4)
  remarks   String?    @db.VarChar(200)
  enquiry   SalEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@unique([enquiryId, lineNo])
  @@index([tenantId, itemCode])
  @@map("sal_enquiry_item")
}

enum SalQuotationStatus {
  DRAFT
  PENDING_APPROVAL
  RELEASED
  ORDERED
  LOST
  SUPERSEDED
}

model SalQuotation {
  id               String             @id @default(uuid()) @db.Char(36)
  tenantId         String             @db.Char(36)
  docNo            String             @db.VarChar(30)
  revision         Int                @default(0) // revisions keep the number
  docDate          DateTime           @db.Date
  validUntil       DateTime?          @db.Date
