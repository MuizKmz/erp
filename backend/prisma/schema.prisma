  @@index([tenantId])
  @@map("pur_debit_note_line")
}

enum PurReturnStatus {
  DRAFT
  RELEASED // waiting for the supplier's credit note or replacement
  SETTLED
}

enum PurSettleBy {
  CREDIT_NOTE
  REPLACEMENT
}

/// Goods sent back after they were received. Migrated rows may point to an old-system GRN by number only.
model PurReturn {
  id               String            @id @default(uuid()) @db.Char(36)
  tenantId         String            @db.Char(36)
  docNo            String            @db.VarChar(30)
  docDate          DateTime          @db.Date
  status           PurReturnStatus   @default(DRAFT)
  branchCode       String            @db.VarChar(10)
  grnId            String?           @db.Char(36)
  grnNo            String            @db.VarChar(30)
  poId             String?           @db.Char(36)
  poNo             String?           @db.VarChar(30)
  supplierId       String            @db.Char(36)
  supplierCode     String            @db.VarChar(20)
  supplierName     String            @db.VarChar(150)
  reason           String            @db.VarChar(200)
  settleBy         PurSettleBy       @default(CREDIT_NOTE)
  rmaNo            String?           @db.VarChar(50)
  collection       String?           @db.VarChar(200) // "Supplier lorry · 30 Sep"
  collectionDate   DateTime?         @db.Date
  summary          String?           @db.VarChar(200)
  subtotal         Decimal           @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal           @default(0) @db.Decimal(18, 2)
