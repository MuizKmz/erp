  noteToSupplier   String?                @db.Text
  sourceType       PurOrderSource         @default(BUYER)
  sourceNo         String?                @db.VarChar(30) // PRQ-0004, RFQ-0002, SO-0003
  requestId        String?                @db.Char(36)
  rfqId            String?                @db.Char(36)
  salesOrderNo     String?                @db.VarChar(30)
  customerName     String?                @db.VarChar(150)
  subtotal         Decimal                @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal                @default(0) @db.Decimal(18, 2)
  total            Decimal                @default(0) @db.Decimal(18, 2)
  approvalRequired Boolean                @default(false)
  approvedAt       DateTime?              @db.DateTime(3)
  releasedAt       DateTime?              @db.DateTime(3)
  releasedByCode   String?                @db.VarChar(20)
  releasedByName   String?                @db.VarChar(100)
