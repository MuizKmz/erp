# Copy to .env and fill in your MySQL root password.
DATABASE_URL="mysql://root:<password>@localhost:3306/zora_erp"

# dev = no login; the x-dev-user header picks the user (default LMY)
AUTH_MODE=dev
DEV_DEFAULT_USER=LMY
DEV_TENANT_CODE=CLB

PORT=3000
CORS_ORIGIN=http://localhost:5173

# Local attachment storage, relative to backend/
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# Outbox dispatcher
OUTBOX_DISPATCH=on
OUTBOX_INTERVAL_MS=5000
