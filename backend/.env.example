# Copy to .env and fill in your MySQL root password.
DATABASE_URL="mysql://root:<password>@localhost:3306/zora_erp"

# dev = no password; the x-dev-user header picks the user (default LMY), as in the demo.
# jwt = sign in with email or user code and password (seeded users: Zora-demo-2026).
# Required, so a server missing it never falls back to dev mode. With NODE_ENV=production the server only starts with
# AUTH_MODE=jwt, COOKIE_SECURE=on, its own DEV_TENANT_CODE, and DEV_TODAY and DEMO_ADMIN_2FA_BYPASS_CODE empty.
AUTH_MODE=dev
# Required with AUTH_MODE=jwt: at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Local demo only: ADM may enter this code instead of scanning a two-factor QR code. Leave blank in shared or production environments.
DEMO_ADMIN_2FA_BYPASS_CODE=
# on = the refresh cookie only travels over HTTPS (production). off for localhost.
COOKIE_SECURE=off
DEV_DEFAULT_USER=LMY
# The tenant this server serves, in both modes
DEV_TENANT_CODE=CLB

PORT=3000
CORS_ORIGIN=http://localhost:5173
# The web app, for links in emails (supplier RFQ reply links)
APP_URL=http://localhost:5173

# Local attachment storage, relative to backend/
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# Optional: a client's WMS, for live stock figures and the read-only WMS module. Leave WMS_URL empty to use the stock snapshot.
WMS_URL=
WMS_EMAIL=
WMS_PASSWORD=
# The WMS website, for the "Open in WMS" button. The button is hidden when this is empty.
WMS_WEB_URL=

# Outbox dispatcher
OUTBOX_DISPATCH=on
OUTBOX_INTERVAL_MS=5000

# Dev only: pretend today is this date so the screens match the mockups (Tuesday 29 Sep 2026).
# Leave empty to use the real date.
DEV_TODAY=2026-09-29
